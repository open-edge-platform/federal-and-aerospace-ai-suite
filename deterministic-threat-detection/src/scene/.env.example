# Self-contained environment for the deterministic threat detection (HOTA) app.
# Run ./up.sh; it generates secrets and fills SUPASS/HOST_IP below.

HOST_IP=

# This machine's address on the lab network, as the browser reaches it (WebRTC ICE candidates); set by make up
LAB_IP=

# SceneScape images (manager, controller, analytics)
SCENESCAPE_VERSION=2026.3.0-20261020-weekly

# DL Streamer Pipeline Server image
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.3.0-20261020-weekly-ubuntu24

# RTSP camera hosts on the TSN VLAN (must match src/mediamtx/mediamtx.yml)
CAMERA1_HOST=192.168.127.12
CAMERA2_HOST=192.168.127.13

# Comma-separated hosts/IPs allowed in the browser URL; set by make up; '*' allows any host
ALLOWED_HOSTS=*

NGINX_CLIENT_MAX_BODY_SIZE=132m

# Admin password; populated by up.sh from src/secrets/supass
SUPASS=

# Broker runs as the image default user; leave blank (see up.sh)
UID=
GID=
